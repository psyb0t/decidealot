{
  "name": "@psyb0t/decidealot",
  "version": "0.0.0",
  "mcpName": "io.github.psyb0t/decidealot",
  "description": "Connect an OpenClaw or MCP agent to a self-hosted Decidealot server.",
  "type": "module",
  "bin": {
    "decidealot-mcp": "bin/cli.js"
  },
  "files": [
    "bin",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "psyb0t",
  "homepage": "https://github.com/psyb0t/decidealot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psyb0t/decidealot.git"
  },
  "bugs": {
    "url": "https://github.com/psyb0t/decidealot/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "decidealot",
    "laya",
    "von",
    "local-ai",
    "openclaw"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mcp-remote": "0.1.38"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": [
      "./bin/cli.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
