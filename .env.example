# Empty means no bearer token is required. Set a real secret before exposing the
# loopback port through a reverse proxy or another network boundary.
DECIDEALOT_API_KEY=

# Persistent writable model directories for Laya and Von. Decidealot downloads
# each missing official model bundle here once, then reuses it after restarts.
DECIDEALOT_MODEL_DATA_DIR=/models

# Leave empty to use provider subdirectories below DECIDEALOT_MODEL_DATA_DIR.
# The optional local-model Compose override maps writable host directories here.
DECIDEALOT_LAYA_MODEL_DIR=
DECIDEALOT_VON_MODEL_DIR=

DECIDEALOT_DEFAULT_MODEL=laya
DECIDEALOT_LOG_LEVEL=INFO
DECIDEALOT_MAX_REQUEST_BYTES=1048576
# Set to 0 to disable idle unloading. A positive value stops the resident model,
# releasing its complete Torch runtime. Switching models always unloads the old one.
DECIDEALOT_PROVIDER_IDLE_UNLOAD_SECONDS=600
