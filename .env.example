# Empty means no bearer token is required. Set a real secret before exposing the
# loopback port through a reverse proxy or another network boundary.
DECIDEALOT_API_KEY=

# Required only by docker-compose.yml. This host directory is bind-mounted at
# the fixed container path /models and receives laya, von, and clm subdirectories.
# The Compose commands pass DECIDEALOT_UID and DECIDEALOT_GID from id -u and id -g.
# Each missing value falls back to non-root 1000.
DECIDEALOT_MODEL_DIRECTORY=/srv/decidealot/models

DECIDEALOT_LOG_LEVEL=INFO
DECIDEALOT_MAX_REQUEST_BYTES=1048576
# 0 leaves the batch item count uncapped; the request body size still applies.
DECIDEALOT_MAX_BATCH_REQUESTS=0
# 0 leaves provider-call concurrency to model and device scheduling. Set a
# positive value to cap simultaneous provider calls made by batch requests.
DECIDEALOT_MAX_BATCH_CONCURRENCY=0
# Comma-separated MCP Host header allowlist. The defaults cover loopback and
# the Docker Compose service name. Add the exact host name used by a reverse proxy.
DECIDEALOT_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*,decidealot,decidealot:*
# Comma-separated MCP browser Origin allowlist. Add the exact scheme and host
# only when a browser-capable MCP client reaches Decidealot through a proxy.
DECIDEALOT_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
# Set to 0 to disable idle unloading. A positive value stops the resident model,
# releasing its complete Torch runtime. Switching evicts an idle model only
# when the resident-provider limit has been reached.
DECIDEALOT_PROVIDER_IDLE_UNLOAD_SECONDS=600
# Keep one local model resident by default. Set 2 or 3 only when the host has
# enough RAM or VRAM for simultaneous local model processes.
DECIDEALOT_MAX_RESIDENT_LOCAL_PROVIDERS=1

# Set false to skip a local provider bundle. CLM's auto value enables it only
# when DECIDEALOT_CLM_EMBEDDINGS_URL is configured.
DECIDEALOT_LAYA_ENABLED=true
DECIDEALOT_VON_ENABLED=true
DECIDEALOT_CLM_ENABLED=auto
# CLM needs an OpenAI-compatible /v1/embeddings URL that returns Qwen3-8B
# last-token embeddings with exactly 4096 float values per input.
DECIDEALOT_CLM_EMBEDDINGS_URL=
DECIDEALOT_CLM_EMBEDDINGS_MODEL=qwen3-8b
DECIDEALOT_CLM_EMBEDDINGS_API_KEY=
DECIDEALOT_CLM_EMBEDDINGS_TIMEOUT_SECONDS=120
# Candidate vectors only. Raw decision state is never cached. Zero disables caching.
DECIDEALOT_CLM_CANDIDATE_CACHE_ENTRIES=1024
DECIDEALOT_CLM_CANDIDATE_CACHE_TTL_SECONDS=600
# Per rendered state+instructions or candidate, measured in UTF-8 bytes, not tokens.
DECIDEALOT_CLM_MAX_TEXT_BYTES=8192
# Keep CLM and its configured Qwen encoder serial with other local models by
# default. Set true only when the encoder and CLM can safely overlap them.
DECIDEALOT_CLM_PARALLEL_WITH_LOCAL_MODELS=false

# Jev is hosted by TypeSafe. A key enables it automatically unless explicitly
# disabled. The full decision state and questions are sent to TypeSafe.
DECIDEALOT_TYPESAFE_API_KEY=
DECIDEALOT_JEV_ENABLED=auto
