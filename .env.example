# Empty means no bearer token is required. Set a real secret before exposing the
# loopback port through a reverse proxy or another network boundary.
DECIDEALOT_API_KEY=

# Required only by docker-compose.yml. This host directory is bind-mounted at
# the fixed container path /models and receives the laya and von subdirectories.
# The Compose commands pass DECIDEALOT_UID and DECIDEALOT_GID from id -u and id -g.
# Each missing value falls back to non-root 1000.
DECIDEALOT_MODEL_DIRECTORY=/srv/decidealot/models

DECIDEALOT_LOG_LEVEL=INFO
DECIDEALOT_MAX_REQUEST_BYTES=1048576
# Comma-separated MCP Host header allowlist. The defaults cover loopback and
# the Docker Compose service name. Add the exact host name used by a reverse proxy.
DECIDEALOT_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*,decidealot,decidealot:*
# Comma-separated MCP browser Origin allowlist. Add the exact scheme and host
# only when a browser-capable MCP client reaches Decidealot through a proxy.
DECIDEALOT_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
# Set to 0 to disable idle unloading. A positive value stops the resident model,
# releasing its complete Torch runtime. Switching models always unloads the old one.
DECIDEALOT_PROVIDER_IDLE_UNLOAD_SECONDS=600
